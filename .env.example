# Copy to .env and fill in. .env is git-ignored and must never be committed.

# LLM provider (openai); other vendors plug in by implementing engine.llm.Provider
LLM_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1

# Shared secret between the engine and the mock systems
# MOCK_API_KEY=dev-key

# Database. Unset = local SQLite file (data/local.db). For PostgreSQL, fill DB_* below once and run
# `uv run python -m engine.db_setup`; it writes DATABASE_URL for a least-privilege app user here.
# DATABASE_URL=postgresql+asyncpg://loan_app:...@host:5432/loan_servicing?ssl=require
# DB_HOST=
# DB_PORT=5432
# DB_ADMIN_USER=
# DB_ADMIN_PASSWORD=
# DB_ADMIN_DATABASE=postgres

# Observability (Langfuse). Unset = tracing off.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# APP_ENV=development
